import Mathlib.Probability.Kernel.IonescuTulcea.Traj
import Mathlib.Topology.Sion

/-!
# Sequential-kernel / tower / minimax interface

This module packages three existing Mathlib constructions into one theorem:

* Ionescu--Tulcea turns a measurable family of history-dependent transition kernels
  into a probability kernel on complete trajectories.
* Kernel.condExp_traj identifies conditioning on a finite prefix with integration
  against the continuation trajectory kernel (the tower step).
* Sion's minimax theorem gives the inf-sup / sup-inf equality for compact convex
  strategy sets when the resulting expected payoff has the required semicontinuity
  and quasi-convexity / quasi-concavity.

The regularity hypotheses in SequentialKernelGame are intentional. A probability
kernel alone does not make an arbitrary terminal payoff jointly measurable, nor does
it make its expectation affine or continuous in strategy parameters.
-/

open MeasureTheory
open scoped ProbabilityTheory

namespace PublicSetting.SequentialKernelMinimax

/-- The full trajectory law generated by a sequence of history-dependent kernels.
The initial history is a measurable encoding of the two players' strategy parameters.
The transition kernels may depend on the entire finite history. -/
noncomputable def strategyPathKernel
    {E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel (Π i : Set.Iic n, States i)
      (States (n + 1)))
    (initial : E × F → Π i : Set.Iic 0, States i)
    (hinitial : Measurable initial) :
    ProbabilityTheory.Kernel (E × F) (Π n, States n) :=
  ProbabilityTheory.Kernel.traj κ 0 ∘ₖ
    ProbabilityTheory.Kernel.deterministic initial hinitial

/-- The trajectory kernel constructed above is a Markov kernel whenever the
one-step transition kernels are Markov kernels. -/
theorem strategyPathKernel_isMarkov
    {E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel (Π i : Set.Iic n, States i)
      (States (n + 1)))
    (initial : E × F → Π i : Set.Iic 0, States i)
    (hinitial : Measurable initial)
    (hκ : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n)) :
    ProbabilityTheory.IsMarkovKernel (strategyPathKernel κ initial hinitial) := by
  letI : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n) := hκ
  dsimp [strategyPathKernel]
  infer_instance

/-- Consistency of finite-prefix kernels with the infinite trajectory kernel.
This is the kernel-composition form of sequential probability construction. -/
theorem finitePrefix_consistency
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel (Π i : Set.Iic n, States i)
      (States (n + 1)))
    {a b : ℕ} (hab : a ≤ b) :
    ProbabilityTheory.Kernel.traj κ b ∘ₖ
      ProbabilityTheory.Kernel.partialTraj κ a b =
        ProbabilityTheory.Kernel.traj κ a :=
  ProbabilityTheory.Kernel.traj_comp_partialTraj hab

/-- Tower property for a sequential process: condition the complete-path payoff
on the information available up to time b, and the conditional expectation is
the expected continuation payoff under the trajectory kernel restarted at b. -/
theorem trajectory_tower
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel (Π i : Set.Iic n, States i)
      (States (n + 1)))
    {a b : ℕ} (hab : a ≤ b)
    (x₀ : Π i : Set.Iic a, States i)
    (f : (Π n, States n) → E)
    (hf : Integrable f (ProbabilityTheory.Kernel.traj κ a x₀)) :
    (ProbabilityTheory.Kernel.traj κ a x₀)[f | ProbabilityTheory.Kernel.piLE b] =ᵐ[
      ProbabilityTheory.Kernel.traj κ a x₀]
      fun x ↦ ∫ y, f y ∂ProbabilityTheory.Kernel.traj κ b
        (Preorder.frestrictLe b x) :=
  ProbabilityTheory.Kernel.condExp_traj hab hf

/-- Expected terminal reward generated by a trajectory kernel. -/
noncomputable def pathPayoff
    {E F Ω : Type*} [MeasurableSpace Ω]
    (K : ProbabilityTheory.Kernel (E × F) Ω)
    (reward : Ω → ℝ) (x : E) (y : F) : ℝ :=
  ∫ ω, reward ω ∂K (x, y)

/-- A feasible strategy space for one player. The carrier is explicitly a
nonempty, compact, convex subset of a real topological vector space. For finite
pure-plan games it can be instantiated by the probability simplex. -/
structure CompactConvexStrategySpace (E : Type*)
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E] where
  carrier : Set E
  nonempty : carrier.Nonempty
  convex : Convex ℝ carrier
  compact : IsCompact carrier

/-- A sequential zero-sum game whose payoff is generated by history-dependent
stochastic kernels. The two strategy carriers are compact and convex. The
payoff regularity assumptions are exactly the Sion hypotheses; they must be
proved from the chosen model (for example, from a finite mixed-strategy
normal-form representation), not inferred from kernel measurability alone. -/
structure SequentialKernelGame
    (E F : Type*)
    [MeasurableSpace E] [MeasurableSpace F]
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [TopologicalSpace F] [AddCommGroup F] [Module ℝ F]
    [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
    (States : ℕ → Type*) [∀ n, MeasurableSpace (States n)] where
  minimizing : CompactConvexStrategySpace E
  maximizing : CompactConvexStrategySpace F
  transition : (n : ℕ) → ProbabilityTheory.Kernel
    (Π i : Set.Iic n, States i) (States (n + 1))
  initial : E × F → Π i : Set.Iic 0, States i
  initial_measurable : Measurable initial
  transition_markov : ∀ n, ProbabilityTheory.IsMarkovKernel (transition n)
  reward : (Π n, States n) → ℝ
  reward_integrable : ∀ x ∈ minimizing.carrier, ∀ y ∈ maximizing.carrier,
    Integrable reward
      (strategyPathKernel transition initial initial_measurable (x, y))
  payoff_lower_semicontinuous :
    ∀ y ∈ maximizing.carrier,
      LowerSemicontinuousOn
        (fun x ↦ pathPayoff
          (strategyPathKernel transition initial initial_measurable) reward x y)
        minimizing.carrier
  payoff_quasiconvex :
    ∀ y ∈ maximizing.carrier,
      QuasiconvexOn ℝ minimizing.carrier
        (fun x ↦ pathPayoff
          (strategyPathKernel transition initial initial_measurable) reward x y)
  payoff_upper_semicontinuous :
    ∀ x ∈ minimizing.carrier,
      UpperSemicontinuousOn
        (fun y ↦ pathPayoff
          (strategyPathKernel transition initial initial_measurable) reward x y)
        maximizing.carrier
  payoff_quasiconcave :
    ∀ x ∈ minimizing.carrier,
      QuasiconcaveOn ℝ maximizing.carrier
        (fun y ↦ pathPayoff
          (strategyPathKernel transition initial initial_measurable) reward x y)

/-- Minimax theorem for the trajectory payoff of a sequential-kernel game.

The infimum is over the minimizing player's compact convex strategy set and the
supremum over the maximizing player's compact convex strategy set. Sion's
regularity assumptions are imposed on the expected terminal reward induced by
the complete trajectory kernel. -/
theorem sequential_kernel_minimax
    {E F : Type*}
    [MeasurableSpace E] [MeasurableSpace F]
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [TopologicalSpace F] [AddCommGroup F] [Module ℝ F]
    [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (G : SequentialKernelGame E F States) :
    (⨅ x ∈ G.minimizing.carrier, ⨆ y ∈ G.maximizing.carrier,
      pathPayoff
        (strategyPathKernel G.transition G.initial G.initial_measurable)
        G.reward x y)
      =
    ⨆ y ∈ G.maximizing.carrier, ⨅ x ∈ G.minimizing.carrier,
      pathPayoff
        (strategyPathKernel G.transition G.initial G.initial_measurable)
        G.reward x y := by
  exact Sion.minimax'
    G.minimizing.nonempty
    G.minimizing.convex
    G.minimizing.compact
    G.payoff_lower_semicontinuous
    G.payoff_quasiconvex
    G.maximizing.convex
    G.payoff_upper_semicontinuous
    G.payoff_quasiconcave

end PublicSetting.SequentialKernelMinimax
