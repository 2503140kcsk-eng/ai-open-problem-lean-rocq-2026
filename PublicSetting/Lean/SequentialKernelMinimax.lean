module

public import Mathlib.Probability.Kernel.IonescuTulcea.Traj
public import Mathlib.Topology.Sion
public import Mathlib.Probability.Process.Filtration
public import Mathlib.Geometry.Convex.ConvexSpace.CompactSpaceStdSimplex

/-!
# Sequential-kernel / tower / minimax interface

Ionescu--Tulcea constructs full path laws from history-dependent transition
kernels. Mathlib's conditional-expectation theorem condExp_traj identifies
conditioning on a finite prefix with integration against the continuation kernel.
Sion's theorem then gives inf-sup = sup-inf for compact convex strategy spaces
provided the induced expected payoff has the required semicontinuity and
quasi-convexity / quasi-concavity.

These regularity assumptions are explicit: kernel measurability by itself does not
imply strategy-space compactness, payoff convexity, or Sion's hypotheses.
-/

open MeasureTheory
open scoped ProbabilityTheory

set_option maxHeartbeats 400000

namespace PublicSetting.SequentialKernelMinimax

/-- The full trajectory law generated by a family of history-dependent Markov
kernels and a measurable initial history depending on both strategy parameters. -/
noncomputable def strategyPathKernel
    {E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    [MeasurableSpace (E × F)]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    (hκ : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n))
    (initial : E × F → Π i : Finset.Iic 0, States i)
    (hinitial : Measurable initial) :
    ProbabilityTheory.Kernel (E × F) (Π n, States n) := by
  letI : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n) := hκ
  exact ProbabilityTheory.Kernel.traj κ 0 ∘ₖ
    ProbabilityTheory.Kernel.deterministic initial hinitial

/-- The complete path law is a Markov kernel. -/
theorem strategyPathKernel_isMarkov
    {E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    [MeasurableSpace (E × F)]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    [hκ : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n)]
    (initial : E × F → Π i : Finset.Iic 0, States i)
    (hinitial : Measurable initial) :
    ProbabilityTheory.IsMarkovKernel (strategyPathKernel κ hκ initial hinitial) := by
  dsimp [strategyPathKernel]
  infer_instance

/-- Finite-prefix consistency of the Ionescu--Tulcea trajectory kernels. -/
theorem finitePrefix_consistency
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    [hκ : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n)]
    {a b : ℕ} (hab : a ≤ b) :
    ProbabilityTheory.Kernel.traj κ b ∘ₖ
      ProbabilityTheory.Kernel.partialTraj κ a b =
        ProbabilityTheory.Kernel.traj κ a :=
  ProbabilityTheory.Kernel.traj_comp_partialTraj hab

/-- Tower property for a sequential process: conditional expectation of an
integrable full-path reward given the coordinates through time b equals the
continuation-kernel expectation, almost everywhere. -/
theorem trajectory_tower
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    [hκ : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n)]
    {a b : ℕ} (hab : a ≤ b)
    (x₀ : Π i : Finset.Iic a, States i)
    (f : (Π n, States n) → E)
    (hf : Integrable f (ProbabilityTheory.Kernel.traj κ a x₀)) :
    (ProbabilityTheory.Kernel.traj κ a x₀)[f | MeasureTheory.Filtration.piLE b] =ᵐ[
      ProbabilityTheory.Kernel.traj κ a x₀]
      fun x ↦ ∫ y, f y ∂ProbabilityTheory.Kernel.traj κ b
        (Preorder.frestrictLe b x) :=
  ProbabilityTheory.Kernel.condExp_traj hab hf

/-- A complete trajectory law for a pair of fixed behavioral strategies.
Each strategy pair (e,f) selects its own family of transition kernels.
At round n, the kernel may depend on the entire realized prefix
Pi i : Finset.Iic n, States i; no Markov-in-the-current-state
restriction is imposed. This is the path-space construction for arbitrary
history-dependent randomized policies. -/
noncomputable def strategyDependentPathMeasure
    {E F : Type*}
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : E × F → (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    (hκ : ∀ p n, ProbabilityTheory.IsMarkovKernel (κ p n))
    (initial : E × F → Π i : Finset.Iic 0, States i)
    (x : E) (y : F) : Measure (Π n, States n) := by
  letI : ∀ n, ProbabilityTheory.IsMarkovKernel (κ (x, y) n) :=
    fun n => hκ (x, y) n
  exact ProbabilityTheory.Kernel.traj (κ (x, y)) 0 (initial (x, y))

/-- Every strategy-indexed path law is a probability measure. -/
theorem strategyDependentPathMeasure_isProbability
    {E F : Type*}
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : E × F → (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    (hκ : ∀ p n, ProbabilityTheory.IsMarkovKernel (κ p n))
    (initial : E × F → Π i : Finset.Iic 0, States i)
    (x : E) (y : F) :
    IsProbabilityMeasure (strategyDependentPathMeasure κ hκ initial x y) := by
  dsimp [strategyDependentPathMeasure]
  letI : ∀ n, ProbabilityTheory.IsMarkovKernel (κ (x, y) n) :=
    fun n => hκ (x, y) n
  infer_instance

/-- The tower identity holds separately for every fixed pair of
history-dependent behavioral strategies. Thus an arbitrary strategy-indexed
kernel family inherits the same finite-prefix conditional-expectation law. -/
theorem strategyDependent_trajectory_tower
    {E F : Type*}
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : E × F → (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    (hκ : ∀ p n, ProbabilityTheory.IsMarkovKernel (κ p n))
    (x : E) (y : F)
    {a b : ℕ} (hab : a ≤ b)
    (x₀ : Π i : Finset.Iic a, States i)
    (f : (Π n, States n) → ℝ)
    (hf : Integrable f (ProbabilityTheory.Kernel.traj (κ (x, y)) a x₀)) :
    (ProbabilityTheory.Kernel.traj (κ (x, y)) a x₀)[f |
      MeasureTheory.Filtration.piLE b] =ᵐ[
        ProbabilityTheory.Kernel.traj (κ (x, y)) a x₀]
      fun path ↦ ∫ future, f future ∂ProbabilityTheory.Kernel.traj (κ (x, y)) b
        (Preorder.frestrictLe b path) := by
  letI : ∀ n, ProbabilityTheory.IsMarkovKernel (κ (x, y) n) :=
    fun n => hκ (x, y) n
  exact trajectory_tower (κ (x, y)) hab x₀ f hf

/-- Expected terminal reward generated by a path kernel. -/
noncomputable def pathPayoff
    {E F Ω : Type*} [MeasurableSpace E] [MeasurableSpace F]
    [MeasurableSpace (E × F)] [MeasurableSpace Ω]
    (K : ProbabilityTheory.Kernel (E × F) Ω)
    (reward : Ω → ℝ) (x : E) (y : F) : ℝ :=
  ∫ ω, reward ω ∂K (x, y)

/-- Abstract feasible-strategy interface. A finite mixed-strategy simplex is
an intended instance, but its concrete simplex construction is separate. -/
structure CompactConvexStrategySpace (E : Type*)
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E] where
  carrier : Set E
  nonempty : carrier.Nonempty
  convex : Convex ℝ carrier
  compact : IsCompact carrier

/-- The mixed-strategy carrier for a finite set of pure contingent plans.
A point is the vector of probabilities assigned to the pure plans. -/
def finiteMixedStrategyCarrier (A : Type*) [Fintype A] :
    Set (A → ℝ) :=
  Set.range (fun p : Convexity.StdSimplex ℝ A => (p.weights : A → ℝ))

/-- The mixed strategies over finitely many pure plans form a nonempty compact
convex subset of the ambient real vector space of probability vectors. -/
noncomputable def finiteMixedStrategySpace (A : Type*) [Fintype A] [Nonempty A] :
    CompactConvexStrategySpace (A → ℝ) where
  carrier := finiteMixedStrategyCarrier A
  nonempty := by
    let p : Convexity.StdSimplex ℝ A :=
      Convexity.StdSimplex.single (Classical.choice (inferInstance : Nonempty A))
    exact ⟨p.weights, ⟨p, rfl⟩⟩
  convex := by
    intro x hx y hy a b ha hb hab
    rcases hx with ⟨p, rfl⟩
    rcases hy with ⟨q, rfl⟩
    let r : Convexity.StdSimplex ℝ A :=
      Convexity.convexCombPair a b ha hb hab p q
    change a • (p.weights : A → ℝ) + b • (q.weights : A → ℝ) ∈
      Set.range (fun z : Convexity.StdSimplex ℝ A => (z.weights : A → ℝ))
    refine ⟨r, ?_⟩
    funext i
    simp [r, Convexity.StdSimplex.weights_convexCombPair]
  compact := by
    change IsCompact
      (Set.range (fun p : Convexity.StdSimplex ℝ A => (p.weights : A → ℝ)))
    rw [← Set.image_univ]
    exact isCompact_univ.image
      (Convexity.StdSimplex.isEmbedding_toFun_comp_weights ℝ A).continuous


/-- A sequential zero-sum game over compact convex strategy sets. Each
transition may depend on the complete public history. -/
structure SequentialKernelGame
    (E F : Type*)
    [MeasurableSpace E] [MeasurableSpace F] [MeasurableSpace (E × F)]
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [TopologicalSpace F] [AddCommGroup F] [Module ℝ F]
    [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
    (States : ℕ → Type*) [∀ n, MeasurableSpace (States n)] where
  minimizing : CompactConvexStrategySpace E
  maximizing : CompactConvexStrategySpace F
  /-- Each strategy pair induces its own complete history-dependent
  sequence of one-step kernels. -/
  transition : E × F → (n : ℕ) → ProbabilityTheory.Kernel
    (Π i : Finset.Iic n, States i) (States (n + 1))
  initial : E × F → Π i : Finset.Iic 0, States i
  transition_markov : ∀ p n, ProbabilityTheory.IsMarkovKernel (transition p n)
  reward : (Π n, States n) → ℝ
  reward_integrable : ∀ x ∈ minimizing.carrier, ∀ y ∈ maximizing.carrier,
    Integrable reward
      (strategyDependentPathMeasure transition transition_markov initial x y)

/-- Expected payoff of the sequential game. -/
noncomputable def sequentialGamePayoff
    {E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    [MeasurableSpace (E × F)]
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [TopologicalSpace F] [AddCommGroup F] [Module ℝ F]
    [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (G : SequentialKernelGame E F States)
    (x : E) (y : F) : ℝ :=
  ∫ ω, G.reward ω ∂
    strategyDependentPathMeasure G.transition G.transition_markov G.initial x y

/-- Sion's minimax theorem for a sequential-kernel game.

The values are stated as greatest lower bounds / least upper bounds rather
than using a complete-lattice infimum or supremum on ℝ. This matters because
ℝ is only conditionally complete: Sion's general linear-order theorem is the
correct Mathlib result for real-valued payoffs.

Here sup_y and inf_x are the pointwise extrema in the opponent's strategy,
while inf_sup and sup_inf are respectively the GLB and LUB over the two
strategy sets. -/
theorem sequential_kernel_minimax
    {E F : Type*}
    [MeasurableSpace E] [MeasurableSpace F] [MeasurableSpace (E × F)]
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [TopologicalSpace F] [AddCommGroup F] [Module ℝ F]
    [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (G : SequentialKernelGame E F States)
    (h_lsc : ∀ y ∈ G.maximizing.carrier,
      LowerSemicontinuousOn (fun x => sequentialGamePayoff G x y)
        G.minimizing.carrier)
    (h_qconvex : ∀ y ∈ G.maximizing.carrier,
      QuasiconvexOn ℝ G.minimizing.carrier (fun x => sequentialGamePayoff G x y))
    (h_usc : ∀ x ∈ G.minimizing.carrier,
      UpperSemicontinuousOn (fun y => sequentialGamePayoff G x y)
        G.maximizing.carrier)
    (h_qconcave : ∀ x ∈ G.minimizing.carrier,
      QuasiconcaveOn ℝ G.maximizing.carrier (fun y => sequentialGamePayoff G x y))
    (sup_y : E → ℝ)
    (hsup_y : ∀ x ∈ G.minimizing.carrier,
      IsLUB {sequentialGamePayoff G x y | y ∈ G.maximizing.carrier} (sup_y x))
    (inf_sup : ℝ)
    (hinf_sup : IsGLB {sup_y x | x ∈ G.minimizing.carrier} inf_sup)
    (inf_x : F → ℝ)
    (hinf_x : ∀ y ∈ G.maximizing.carrier,
      IsGLB {sequentialGamePayoff G x y | x ∈ G.minimizing.carrier} (inf_x y))
    (sup_inf : ℝ)
    (hsup_inf : IsLUB {inf_x y | y ∈ G.maximizing.carrier} sup_inf) :
    inf_sup = sup_inf := by
  exact Sion.minimax
    G.minimizing.nonempty
    G.minimizing.compact
    h_lsc
    h_qconvex
    G.maximizing.convex
    h_usc
    h_qconcave
    G.minimizing.convex
    sup_y
    hsup_y
    inf_sup
    hinf_sup
    inf_x
    hinf_x
    sup_inf
    hsup_inf

end PublicSetting.SequentialKernelMinimax
