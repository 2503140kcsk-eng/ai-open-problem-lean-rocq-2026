module

public import Mathlib.Probability.Kernel.IonescuTulcea.Traj
public import Mathlib.Topology.Sion
public import Mathlib.Probability.Process.Filtration

/-!
# Sequential-kernel / tower / minimax interface

Ionescu--Tulcea constructs full path laws from history-dependent transition
kernels. Mathlib's conditional-expectation theorem condExp_traj identifies
conditioning on a finite prefix with integration against the continuation kernel.
Sion's theorem then gives inf-sup = sup-inf for compact convex strategy spaces
provided the induced expected payoff has the required semicontinuity and
quasi-convexity / quasi-concavity.

These regularity assumptions are explicit: kernel measurability by itself does not
imply strategy-space compactness, payoff convexity, or Sion's hypotheses.
-/

open MeasureTheory
open scoped ProbabilityTheory

set_option maxHeartbeats 400000

namespace PublicSetting.SequentialKernelMinimax

/-- The full trajectory law generated by a family of history-dependent Markov
kernels and a measurable initial history depending on both strategy parameters. -/
noncomputable def strategyPathKernel
    {E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    [MeasurableSpace (E × F)]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    (hκ : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n))
    (initial : E × F → Π i : Finset.Iic 0, States i)
    (hinitial : Measurable initial) :
    ProbabilityTheory.Kernel (E × F) (Π n, States n) := by
  letI : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n) := hκ
  exact ProbabilityTheory.Kernel.traj κ 0 ∘ₖ
    ProbabilityTheory.Kernel.deterministic initial hinitial

/-- The complete path law is a Markov kernel. -/
theorem strategyPathKernel_isMarkov
    {E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    [MeasurableSpace (E × F)]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    (hκ : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n))
    (initial : E × F → Π i : Finset.Iic 0, States i)
    (hinitial : Measurable initial) :
    ProbabilityTheory.IsMarkovKernel (strategyPathKernel κ hκ initial hinitial) := by
  letI : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n) := hκ
  dsimp [strategyPathKernel]
  infer_instance

/-- Finite-prefix consistency of the Ionescu--Tulcea trajectory kernels. -/
theorem finitePrefix_consistency
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    [hκ : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n)]
    {a b : ℕ} (hab : a ≤ b) :
    ProbabilityTheory.Kernel.traj κ b ∘ₖ
      ProbabilityTheory.Kernel.partialTraj κ a b =
        ProbabilityTheory.Kernel.traj κ a :=
  ProbabilityTheory.Kernel.traj_comp_partialTraj hab

/-- Tower property for a sequential process: conditional expectation of an
integrable full-path reward given the coordinates through time b equals the
continuation-kernel expectation, almost everywhere. -/
theorem trajectory_tower
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (κ : (n : ℕ) → ProbabilityTheory.Kernel
      (Π i : Finset.Iic n, States i) (States (n + 1)))
    [hκ : ∀ n, ProbabilityTheory.IsMarkovKernel (κ n)]
    {a b : ℕ} (hab : a ≤ b)
    (x₀ : Π i : Finset.Iic a, States i)
    (f : (Π n, States n) → E)
    (hf : Integrable f (ProbabilityTheory.Kernel.traj κ a x₀)) :
    (ProbabilityTheory.Kernel.traj κ a x₀)[f | MeasureTheory.Filtration.piLE b] =ᵐ[
      ProbabilityTheory.Kernel.traj κ a x₀]
      fun x ↦ ∫ y, f y ∂ProbabilityTheory.Kernel.traj κ b
        (Preorder.frestrictLe b x) :=
  ProbabilityTheory.Kernel.condExp_traj hab hf

/-- Expected terminal reward generated by a path kernel. -/
noncomputable def pathPayoff
    {E F Ω : Type*} [MeasurableSpace E] [MeasurableSpace F]
    [MeasurableSpace (E × F)] [MeasurableSpace Ω]
    (K : ProbabilityTheory.Kernel (E × F) Ω)
    (reward : Ω → ℝ) (x : E) (y : F) : ℝ :=
  ∫ ω, reward ω ∂K (x, y)

/-- Abstract feasible-strategy interface. A finite mixed-strategy simplex is
an intended instance, but its concrete simplex construction is separate. -/
structure CompactConvexStrategySpace (E : Type*)
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E] where
  carrier : Set E
  nonempty : carrier.Nonempty
  convex : Convex ℝ carrier
  compact : IsCompact carrier

/-- A sequential zero-sum game over compact convex strategy sets. Each
transition may depend on the complete public history. -/
structure SequentialKernelGame
    (E F : Type*)
    [MeasurableSpace E] [MeasurableSpace F] [MeasurableSpace (E × F)]
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [TopologicalSpace F] [AddCommGroup F] [Module ℝ F]
    [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
    (States : ℕ → Type*) [∀ n, MeasurableSpace (States n)] where
  minimizing : CompactConvexStrategySpace E
  maximizing : CompactConvexStrategySpace F
  transition : (n : ℕ) → ProbabilityTheory.Kernel
    (Π i : Finset.Iic n, States i) (States (n + 1))
  initial : E × F → Π i : Finset.Iic 0, States i
  initial_measurable : Measurable initial
  transition_markov : ∀ n, ProbabilityTheory.IsMarkovKernel (transition n)
  reward : (Π n, States n) → ℝ

/-- Expected payoff of the sequential game. -/
noncomputable def sequentialGamePayoff
    {E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    [MeasurableSpace (E × F)]
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [TopologicalSpace F] [AddCommGroup F] [Module ℝ F]
    [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (G : SequentialKernelGame E F States)
    (x : E) (y : F) : ℝ :=
  pathPayoff
    (strategyPathKernel G.transition G.transition_markov
      G.initial G.initial_measurable)
    G.reward x y

/-- Once the expected terminal payoff is lower-semicontinuous and quasiconvex
in the minimizing strategy, upper-semicontinuous and quasiconcave in the
maximizing strategy, and both strategy sets are nonempty compact convex sets,
Sion's theorem proves the minimax equality. -/
theorem sequential_kernel_minimax
    {E F : Type*}
    [MeasurableSpace E] [MeasurableSpace F] [MeasurableSpace (E × F)]
    [TopologicalSpace E] [AddCommGroup E] [Module ℝ E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [TopologicalSpace F] [AddCommGroup F] [Module ℝ F]
    [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
    {States : ℕ → Type*} [∀ n, MeasurableSpace (States n)]
    (G : SequentialKernelGame E F States)
    (h_lsc : ∀ y ∈ G.maximizing.carrier,
      LowerSemicontinuousOn (fun x => sequentialGamePayoff G x y)
        G.minimizing.carrier)
    (h_qconvex : ∀ y ∈ G.maximizing.carrier,
      QuasiconvexOn ℝ G.minimizing.carrier (fun x => sequentialGamePayoff G x y))
    (h_usc : ∀ x ∈ G.minimizing.carrier,
      UpperSemicontinuousOn (fun y => sequentialGamePayoff G x y)
        G.maximizing.carrier)
    (h_qconcave : ∀ x ∈ G.minimizing.carrier,
      QuasiconcaveOn ℝ G.maximizing.carrier (fun y => sequentialGamePayoff G x y)) :
    (⨅ x ∈ G.minimizing.carrier, ⨆ y ∈ G.maximizing.carrier,
      sequentialGamePayoff G x y)
      =
    ⨆ y ∈ G.maximizing.carrier, ⨅ x ∈ G.minimizing.carrier,
      sequentialGamePayoff G x y := by
  exact Sion.minimax'
    (β := ℝ)
    (X := G.minimizing.carrier)
    (Y := G.maximizing.carrier)
    (f := fun x y => sequentialGamePayoff G x y)
    G.minimizing.nonempty
    G.minimizing.convex
    G.minimizing.compact
    h_lsc
    h_qconvex
    G.maximizing.convex
    h_usc
    h_qconcave

end PublicSetting.SequentialKernelMinimax
