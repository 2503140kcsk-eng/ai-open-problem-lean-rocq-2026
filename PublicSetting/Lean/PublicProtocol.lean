import Lean
import PublicSetting

/-!
# Public-setting protocol model

This module formalizes the information order in Section 5.3 of
Shao, Fang, Lin, and Tao, *Partial Feedback Online Learning* (arXiv:2601.21462v3).

The current-round visible witness is selected from the past public transcript,
the current context, and the learner's current distribution/action. It cannot
depend on the current sampled prediction: that value is not an input to
chooseWitness. The terminal target is a single predicate F on hypotheses that
must explain every round's witness.

The final theorem is deliberately a lower-bound example for a bounded-support
action class. It is NOT the randomized-upper/deterministic-lower separation
left open by the paper.
-/

namespace PublicSetting.Protocol

universe u v w z

/-- What the learner knows after a round: context, its chosen distribution/action,
the visible accepted witness, and its own sampled prediction. It does not observe the
hidden acceptable set or a correctness bit. -/
structure Observation (X : Type u) (D : Type v) (Y : Type w) where
  context : X
  policy : D
  witness : Y
  prediction : Y

/-- A completed round additionally records the prediction sampled after the
visible witness has been chosen. -/
structure PublicRound (X : Type u) (D : Type v) (Y : Type w) where
  context : X
  policy : D
  witness : Y
  prediction : Y

def observationOf {X : Type u} {D : Type v} {Y : Type w}
    (r : PublicRound X D Y) : Observation X D Y :=
  ⟨r.context, r.policy, r.witness, r.prediction⟩

/-- The learner remembers its own past samples but receives no hidden-set or loss feedback. -/
def learnerView {X : Type u} {D : Type v} {Y : Type w}
    (history : List (PublicRound X D Y)) : List (Observation X D Y) :=
  history.map observationOf

/-- A learner outputs the current distribution/action from its feedback history
and current context. -/
structure Learner (X : Type u) (D : Type v) (Y : Type w) where
  choosePolicy : List (Observation X D Y) → X → D

/-- The public adversary can see completed past rounds, including their realized
predictions. Its current witness choice sees the current context and distribution,
but not the current sample. -/
structure Adversary (X : Type u) (D : Type v) (Y : Type w) where
  chooseContext : List (PublicRound X D Y) → X
  chooseWitness : List (PublicRound X D Y) → X → D → Y

/-- Execute one protocol round. The let-binding order is part of the model:
context → learner distribution → visible witness → draw from that distribution. -/
def playRound {X : Type u} {D : Type v} {Y : Type w} {Ω : Type z}
    (adversary : Adversary X D Y)
    (learner : Learner X D Y)
    (draw : D → Ω → Y)
    (history : List (PublicRound X D Y))
    (ω : Ω) : List (PublicRound X D Y) :=
  let x := adversary.chooseContext history
  let π := learner.choosePolicy (learnerView history) x
  let yvis := adversary.chooseWitness history x π
  let yhat := draw π ω
  history ++ [⟨x, π, yvis, yhat⟩]

theorem learnerView_length {X : Type u} {D : Type v} {Y : Type w}
    (history : List (PublicRound X D Y)) :
    (learnerView history).length = history.length := by
  simp [learnerView]

theorem playRound_length {X : Type u} {D : Type v} {Y : Type w} {Ω : Type z}
    (adversary : Adversary X D Y)
    (learner : Learner X D Y)
    (draw : D → Ω → Y)
    (history : List (PublicRound X D Y))
    (ω : Ω) :
    (playRound adversary learner draw history ω).length = history.length + 1 := by
  simp [playRound]

/-- The acceptable labels generated by one target subfamily F at context x:
exactly the outputs f(x) of its member hypotheses. -/
def AcceptedLabels {X : Type u} {Y : Type w}
    (F : (X → Y) → Prop) (x : X) (y : Y) : Prop :=
  ∃ f, F f ∧ f x = y

/-- Set-realizability: the *same* F is used for every round of the completed trace. -/
def GloballyRealizable {X : Type u} {D : Type v} {Y : Type w}
    (H F : (X → Y) → Prop) (trace : List (PublicRound X D Y)) : Prop :=
  (∀ f, F f → H f) ∧
  (∀ r, r ∈ trace → AcceptedLabels F r.context r.witness)

theorem target_member_acceptable {X : Type u} {Y : Type w}
    (F : (X → Y) → Prop) (f : X → Y) (hF : F f) (x : X) :
    AcceptedLabels F x (f x) := by
  exact ⟨f, hF, rfl⟩

/-- One global target family that excludes a prescribed prediction at every
coordinate. This is a useful exact model for the infinite-label example in the
paper; it is not asserted to yield the open randomized/deterministic separation. -/
def ComplementFamily (prediction : Nat → Nat) (f : Nat → Nat) : Prop :=
  ∀ t, f t ≠ prediction t

def ComplementAccepts (prediction : Nat → Nat) (t y : Nat) : Prop :=
  ∃ f, ComplementFamily prediction f ∧ f t = y

theorem complement_value_iff (prediction : Nat → Nat) (t y : Nat) :
    (∃ f : Nat → Nat, (∀ s, f s ≠ prediction s) ∧ f t = y) ↔
      y ≠ prediction t := by
  constructor
  · rintro ⟨f, hf, hft⟩
    subst y
    exact hf t
  · intro hy
    refine ⟨fun s => if s = t then y else prediction s + 1, ?_, ?_⟩
    · intro s
      by_cases hst : s = t
      · subst s
        simpa using hy
      · have hne : prediction s + 1 ≠ prediction s :=
          Nat.ne_of_gt (Nat.lt_succ_self (prediction s))
        change (if s = t then y else prediction s + 1) ≠ prediction s
        rw [ite_eq_right hst]
        exact hne
    · exact ite_eq_left (show t = t from rfl)

theorem complement_family_accepts_iff (prediction : Nat → Nat) (t y : Nat) :
    ComplementAccepts prediction t y ↔ y ≠ prediction t := by
  unfold ComplementAccepts ComplementFamily
  exact complement_value_iff prediction t y

theorem complement_family_nonempty (prediction : Nat → Nat) :
    ∃ f : Nat → Nat, ComplementFamily prediction f := by
  refine ⟨fun t => prediction t + 1, ?_⟩
  intro t
  exact Nat.ne_of_gt (Nat.lt_succ_self (prediction t))

/-- A bounded-support sampler. Every possible draw from action d is below
supportBound d. Finite-support distributions on Nat admit such a bound.
This is intentionally a submodel, not a definition of every countably supported PMF. -/
structure BoundedSupportSampler (D : Type v) (Ω : Type z) where
  supportBound : D → Nat
  sample : D → Ω → Nat
  sample_lt_bound : ∀ d ω, sample d ω < supportBound d

def streamPrediction {D : Type v} {Ω : Type z}
    (sampler : BoundedSupportSampler D Ω)
    (actions : Nat → D) (randomStates : Nat → Ω) : Nat → Nat :=
  fun t => sampler.sample (actions t) (randomStates t)

def streamWitness {D : Type v} {Ω : Type z}
    (sampler : BoundedSupportSampler D Ω)
    (actions : Nat → D) : Nat → Nat :=
  fun t => sampler.supportBound (actions t)

/-- The witness is chosen before the current draw and lies outside its support. -/
theorem stream_witness_ne_prediction {D : Type v} {Ω : Type z}
    (sampler : BoundedSupportSampler D Ω)
    (actions : Nat → D) (randomStates : Nat → Ω) (t : Nat) :
    streamWitness sampler actions t ≠ streamPrediction sampler actions randomStates t := by
  exact Nat.ne_of_gt (sampler.sample_lt_bound (actions t) (randomStates t))

/-- A single global target family realizes every acceptable set in this finite-support
counterexample. Its labels at context t are exactly those different from the realized
sample at t. The visible witness is accepted at every round. -/
def boundedSupportGlobalInstance {D : Type v} {Ω : Type z}
    (sampler : BoundedSupportSampler D Ω)
    (actions : Nat → D) (randomStates : Nat → Ω) :
    PublicSetting.GlobalHypothesisInstance where
  H := Nat → Nat
  X := Nat
  Y := Nat
  eval := fun f t => f t
  target := ComplementFamily (streamPrediction sampler actions randomStates)
  contexts := fun t => t
  accepted := fun t y =>
    ComplementAccepts (streamPrediction sampler actions randomStates) t y
  visible := streamWitness sampler actions
  target_nonempty :=
    complement_family_nonempty (streamPrediction sampler actions randomStates)
  accepted_exactly_target_values := by
    intro t y
    rfl
  visible_is_accepted := by
    intro t
    exact (complement_family_accepts_iff
      (streamPrediction sampler actions randomStates) t
      (streamWitness sampler actions t)).2
      (stream_witness_ne_prediction sampler actions randomStates t)

/-- In this bounded-support example, after seeing the realized prediction path,
one fixed nonempty target family explains every visible witness while excluding
every sampled prediction. The terminal F is global, not picked separately per round.
Consequently this example has no randomized o(T) upper bound for this action class. -/
theorem bounded_support_public_attack {D : Type v} {Ω : Type z}
    (T : Nat)
    (sampler : BoundedSupportSampler D Ω)
    (actions : Nat → D) (randomStates : Nat → Ω) :
    ∃ F : (Nat → Nat) → Prop,
      (∃ f, F f) ∧
      ∀ t, t < T →
        ComplementAccepts (streamPrediction sampler actions randomStates) t
          (streamWitness sampler actions t) ∧
        ¬ ComplementAccepts (streamPrediction sampler actions randomStates) t
          (streamPrediction sampler actions randomStates t) := by
  let prediction := streamPrediction sampler actions randomStates
  let visible := streamWitness sampler actions
  refine ⟨ComplementFamily prediction, complement_family_nonempty prediction, ?_⟩
  intro t ht
  have hmis : visible t ≠ prediction t := by
    simpa [visible, prediction] using
      stream_witness_ne_prediction sampler actions randomStates t
  constructor
  · exact (complement_family_accepts_iff prediction t (visible t)).2 hmis
  · intro h
    have hfalse : prediction t ≠ prediction t :=
      (complement_family_accepts_iff prediction t (prediction t)).1 h
    exact hfalse rfl

/-- The sampled path loses on every round against the single global target:
its prediction at t is the unique excluded label for that coordinate. -/
theorem bounded_support_prediction_loss {D : Type v} {Ω : Type z}
    (T : Nat)
    (sampler : BoundedSupportSampler D Ω)
    (actions : Nat → D) (randomStates : Nat → Ω) :
    PublicSetting.totalLoss T
      (streamPrediction sampler actions randomStates)
      (streamPrediction sampler actions randomStates) = T := by
  exact PublicSetting.matched_path_loss T
    (streamPrediction sampler actions randomStates)

/-- The visible witness path is a comparator with zero loss for the same target. -/
theorem bounded_support_comparator_loss_zero {D : Type v} {Ω : Type z}
    (T : Nat)
    (sampler : BoundedSupportSampler D Ω)
    (actions : Nat → D) (randomStates : Nat → Ω) :
    PublicSetting.totalLoss T
      (streamPrediction sampler actions randomStates)
      (streamWitness sampler actions) = 0 := by
  induction T with
  | zero => rfl
  | succ T ih =>
      simp [PublicSetting.totalLoss, ih, stream_witness_ne_prediction]

/-- Consequently, the sampled-path loss minus the loss of this zero-loss comparator
is exactly T. This is a lower-bound example for the bounded-support submodel, not
the open randomized-upper/deterministic-lower separation. -/
theorem bounded_support_pathwise_regret_gap {D : Type v} {Ω : Type z}
    (T : Nat)
    (sampler : BoundedSupportSampler D Ω)
    (actions : Nat → D) (randomStates : Nat → Ω) :
    PublicSetting.totalLoss T
      (streamPrediction sampler actions randomStates)
      (streamPrediction sampler actions randomStates)
    -
    PublicSetting.totalLoss T
      (streamPrediction sampler actions randomStates)
      (streamWitness sampler actions) = T := by
  rw [bounded_support_prediction_loss T sampler actions randomStates]
  rw [bounded_support_comparator_loss_zero T sampler actions randomStates]
  simp

/-- Choose the terminal excluded label after both the realized prediction and
visible witness are known. If they differ, exclude the prediction; on a collision,
exclude a different label so the witness remains accepted. -/
def terminalExclusion (prediction visible : Nat → Nat) (t : Nat) : Nat :=
  if prediction t = visible t then visible t + 1 else prediction t

theorem visible_ne_terminalExclusion
    (prediction visible : Nat → Nat) (t : Nat) :
    visible t ≠ terminalExclusion prediction visible t := by
  by_cases h : prediction t = visible t
  · have hx : terminalExclusion prediction visible t = visible t + 1 := by
      simp [terminalExclusion, h]
    rw [hx]
    exact Ne.symm (Nat.ne_of_gt (Nat.lt_succ_self (visible t)))
  · have hx : terminalExclusion prediction visible t = prediction t := by
      simp [terminalExclusion, h]
    rw [hx]
    exact fun hv => h hv.symm

theorem prediction_eq_terminalExclusion_iff
    (prediction visible : Nat → Nat) (t : Nat) :
    prediction t = terminalExclusion prediction visible t ↔
      prediction t ≠ visible t := by
  by_cases h : prediction t = visible t <;> simp [terminalExclusion, h]

def TerminalFamily (prediction visible : Nat → Nat) (f : Nat → Nat) : Prop :=
  ComplementFamily (terminalExclusion prediction visible) f

def TerminalAccepts (prediction visible : Nat → Nat) (t y : Nat) : Prop :=
  ComplementAccepts (terminalExclusion prediction visible) t y

/-- For every pair of finite/infinite paths, one nonempty global family can make
each visible witness acceptable. The target is chosen from the completed path,
as allowed by the public-setting terminal consistency rule. -/
def terminalGlobalInstance (prediction visible : Nat → Nat) :
    PublicSetting.GlobalHypothesisInstance where
  H := Nat → Nat
  X := Nat
  Y := Nat
  eval := fun f t => f t
  target := TerminalFamily prediction visible
  contexts := fun t => t
  accepted := fun t y => TerminalAccepts prediction visible t y
  visible := visible
  target_nonempty :=
    complement_family_nonempty (terminalExclusion prediction visible)
  accepted_exactly_target_values := by
    intro t y
    rfl
  visible_is_accepted := by
    intro t
    exact (complement_family_accepts_iff
      (terminalExclusion prediction visible) t (visible t)).2
      (visible_ne_terminalExclusion prediction visible t)

/-- Count the rounds on which the prediction differs from its visible witness. -/
def mismatchLoss : Nat → (Nat → Nat) → (Nat → Nat) → Nat
  | 0, _, _ => 0
  | Nat.succ n, prediction, visible =>
      mismatchLoss n prediction visible +
        (if prediction n = visible n then 0 else 1)

theorem terminal_pathwise_loss
    (T : Nat) (prediction visible : Nat → Nat) :
    PublicSetting.totalLoss T (terminalExclusion prediction visible) prediction =
      mismatchLoss T prediction visible := by
  induction T with
  | zero => rfl
  | succ T ih =>
      simp only [PublicSetting.totalLoss, mismatchLoss]
      rw [ih]
      have hstep :
          (if prediction T = terminalExclusion prediction visible T then 1 else 0) =
          (if prediction T = visible T then 0 else 1) := by
        by_cases h : prediction T = visible T <;>
          simp [terminalExclusion, h]
      rw [hstep]

theorem terminal_comparator_loss_zero
    (T : Nat) (prediction visible : Nat → Nat) :
    PublicSetting.totalLoss T (terminalExclusion prediction visible) visible = 0 := by
  induction T with
  | zero => rfl
  | succ T ih =>
      simp only [PublicSetting.totalLoss]
      rw [ih]
      have hne := visible_ne_terminalExclusion prediction visible T
      simp [hne]

/-- The full-product target can make exactly the non-collision rounds mistakes.
Thus a randomized upper bound cannot follow from the round order alone: it must
use structural restrictions on the hypothesis class that prevent this terminal
target from matching most realized predictions. -/
theorem terminal_pathwise_regret_gap
    (T : Nat) (prediction visible : Nat → Nat) :
    PublicSetting.totalLoss T (terminalExclusion prediction visible) prediction -
    PublicSetting.totalLoss T (terminalExclusion prediction visible) visible =
      mismatchLoss T prediction visible := by
  rw [terminal_pathwise_loss, terminal_comparator_loss_zero]
  simp

/-- The requested public-setting separation remains a specification, not a theorem
in this repository: this type alone does not establish either bound. -/
def PublicRandomizedDeterministicSeparation
    (DeterministicLearner : Type)
    (randomizedRegret : Nat → Nat)
    (deterministicRegret : DeterministicLearner → Nat → Nat) : Prop :=
  PublicSetting.AsymptoticSeparationSpec
    DeterministicLearner randomizedRegret deterministicRegret


/-- The target subfamily of a constant-function class is input-independent:
for one fixed family F of constants, every context has the same accepted labels. -/
def ConstantFamilyAccepts (F : Nat → Prop) (_context label : Nat) : Prop :=
  F label

theorem constant_family_accepts_independent
    (F : Nat → Prop) (x x' y : Nat) :
    ConstantFamilyAccepts F x y ↔ ConstantFamilyAccepts F x' y := by
  rfl

/-- Consequently, the standard set-valued separation construction using
different co-singleton sets at different rounds does not directly lift to
set-realizability by a fixed subfamily of constant hypotheses. -/
theorem constant_hypothesis_complement_exclusion_is_fixed
    (excluded : Nat → Nat) (F : Nat → Prop)
    (h : ∀ t y, ConstantFamilyAccepts F t y ↔ y ≠ excluded t) :
    ∀ t s, excluded t = excluded s := by
  intro t s
  have hnot : ¬ ConstantFamilyAccepts F t (excluded t) := by
    intro hF
    have hself : excluded t ≠ excluded t :=
      (h t (excluded t)).mp hF
    exact hself rfl
  by_cases heq : excluded t = excluded s
  · exact heq
  · exfalso
    apply hnot
    exact (h s (excluded t)).mpr heq


/-- Sum of the first n atomic masses of a countable label distribution. -/
def prefixMass (mass : Nat → Rat) : Nat → Rat
  | 0 => 0
  | Nat.succ n => prefixMass mass n + mass n

/-- A nonnegative discrete sub-probability on the countably infinite label set Nat.
Every finite prefix has total mass at most one. -/
structure NatSubprobability where
  mass : Nat → Rat
  mass_nonneg : ∀ n, 0 ≤ mass n
  prefix_le_one : ∀ n, prefixMass mass n ≤ 1

/-- If every atom in a finite prefix has scaled mass greater than one,
the total scaled prefix mass exceeds the prefix length. -/
theorem prefix_scaled_gt
    (mass : Nat → Rat) (T N : Nat)
    (hN : 0 < N)
    (h : ∀ i, i < N → 1 < (T : Rat) * mass i) :
    (N : Rat) < (T : Rat) * prefixMass mass N := by
  induction N with
  | zero => omega
  | succ n ih =>
      by_cases hn : n = 0
      · subst n
        simpa [prefixMass, Rat.zero_add] using h 0 (by omega)
      · have hprev : (n : Rat) < (T : Rat) * prefixMass mass n :=
          ih (by omega) (by
            intro i hi
            exact h i (by omega))
        have hlast : 1 < (T : Rat) * mass n := h n (by omega)
        calc
          (Nat.succ n : Rat) = (n : Rat) + 1 := by simp
          _ = 1 + (n : Rat) := Rat.add_comm _ _
          _ < 1 + ((T : Rat) * prefixMass mass n) :=
            (Rat.add_lt_add_left (c := (1 : Rat))).mpr hprev
          _ = ((T : Rat) * prefixMass mass n) + 1 := Rat.add_comm _ _
          _ < ((T : Rat) * prefixMass mass n) + ((T : Rat) * mass n) :=
            (Rat.add_lt_add_left (c := (T : Rat) * prefixMass mass n)).mpr hlast
          _ = (T : Rat) * prefixMass mass (Nat.succ n) := by
            simp [prefixMass, Rat.mul_add]

/-- Every countable probability mass function has an atom of mass at most 1/T
for any positive integer horizon T. This is the pre-draw low-mass witness fact. -/
theorem exists_low_mass_label
    (p : NatSubprobability) (T : Nat) (hT : 0 < T) :
    ∃ y, (T : Rat) * p.mass y ≤ 1 := by
  by_cases hsmall : ∃ y, (T : Rat) * p.mass y ≤ 1
  · exact hsmall
  · have hall : ∀ y, 1 < (T : Rat) * p.mass y := by
      intro y
      rcases lt_or_ge 1 ((T : Rat) * p.mass y) with hlt | hge
      · exact hlt
      · exact False.elim (hsmall ⟨y, hge⟩)
    have hsum :
        ((T + 1 : Nat) : Rat) <
          (T : Rat) * prefixMass p.mass (T + 1) := by
      exact prefix_scaled_gt p.mass T (T + 1) (by omega) (fun i hi => hall i)
    have hbound :
        (T : Rat) * prefixMass p.mass (T + 1) ≤ (T : Rat) := by
      simpa using Rat.mul_le_mul_of_nonneg_left
        (p.prefix_le_one (T + 1)) (Nat.cast_nonneg T)
    have hcontr : ((T + 1 : Nat) : Rat) < (T : Rat) :=
      lt_of_lt_of_le hsum hbound
    have hTle : (T : Rat) ≤ ((T + 1 : Nat) : Rat) := by
      rw [Nat.cast_add, Nat.cast_one]
      simpa using (Rat.add_le_add_left (c := (T : Rat))).mpr
        (Rat.le_of_lt (show (0 : Rat) < 1 by decide))
    exact (not_lt_of_ge hTle) hcontr

end PublicSetting.Protocol
